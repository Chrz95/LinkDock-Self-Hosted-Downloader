# Required: generate a private password with: openssl rand -hex 32
LINKDOCK_ACCESS_TOKEN=
# Host port used by Docker Compose (container port stays 8080).
PORT=8080
# Concurrent outgoing requests; integer 1–8.
MAX_CONCURRENT_DOWNLOADS=2
# Maximum individual file size in GiB; integer 1–65535.
MAX_FILE_SIZE_GIB=20
# Use true only behind HTTPS. HTTP on your LAN requires false.
SECURE_COOKIE=false
# Optional exact browser-facing origin, without trailing slash, when using an HTTPS reverse proxy.
# PUBLIC_ORIGIN=https://downloads.example.com
# Optional encrypted browser alerts. Requires HTTPS PUBLIC_ORIGIN and SECURE_COOKIE=true.
# Set your real contact; the station creates and retains its private signing keys in /data/notifications.
# WEB_PUSH_SUBJECT=mailto:you@example.com
# Local development only; Compose always uses /data inside the container.
DATA_DIRECTORY=./data

# Optional browser-exported Netscape cookie jar inside the container (read-only mount recommended).
# MEDIA_COOKIES_FILE=/cookies/cookies.txt
# Incoming torrent/DHT peer port; aria2 listens on 6881 inside the container.
TORRENT_PORT=6881
