{
  "name": "linkdock",
  "version": "2.32.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "concurrently -k \"pnpm dev:server\" \"vite --host 0.0.0.0\"",
    "dev:server": "tsx watch --env-file=.env server/index.ts",
    "build": "pnpm typecheck && node scripts/packageBrowserCompanion.mjs && vite build && tsc -p tsconfig.server.json && node scripts/packageMediaRuntime.mjs",
    "start": "node --env-file-if-exists=.env dist-server/server/index.js",
    "preview": "vite preview --host 0.0.0.0",
    "lint": "oxlint --deny-warnings . && eslint --max-warnings 0 . && node scripts/checkConventions.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:production": "node scripts/smokeProduction.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "station": "node --env-file-if-exists=.env dist-server/server/cli.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "ipaddr.js": "^2.5.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "web-push": "^3.6.7",
    "yazl": "^3.3.1"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/supertest": "^7.2.1",
    "@types/web-push": "^3.6.4",
    "@types/yazl": "^3.3.1",
    "@typescript-eslint/parser": "^8.71.2",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "fflate": "^0.8.3",
    "jsdom": "^30.1.3",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
