{
  "manifest_version": 3,
  "name": "LinkDock Browser Companion",
  "version": "1.5.0",
  "minimum_chrome_version": "102",
  "description": "Send links and browser downloads to your LinkDock station, or securely share a selected site session.",
  "permissions": ["activeTab", "scripting", "cookies", "storage", "notifications"],
  "optional_permissions": ["downloads"],
  "optional_host_permissions": ["http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [{ "matches": ["http://*/*", "https://*/*"], "js": ["overlay.js"] }],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Add a download to LinkDock",
    "default_icon": {
      "16": "icons/icon-16.png",
      "24": "icons/icon-24.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "24": "icons/icon-24.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "64": "icons/icon-64.png",
    "128": "icons/icon-128.png"
  }
}
